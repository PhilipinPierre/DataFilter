<UserControl x:Class="DataFilter.Wpf.Controls.FilterTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="HourBox"
                  Width="52"
                  Margin="0,0,4,0"
                  SelectionChanged="OnPartChanged" />
        <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,4,0" />
        <ComboBox x:Name="MinuteBox"
                  Width="52"
                  Margin="0,0,4,0"
                  SelectionChanged="OnPartChanged" />
        <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,4,0" />
        <ComboBox x:Name="SecondBox"
                  Width="52"
                  SelectionChanged="OnPartChanged" />
    </StackPanel>
</UserControl>
